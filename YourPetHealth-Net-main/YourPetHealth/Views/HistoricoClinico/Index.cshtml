@model IEnumerable<YourPetHealth.Models.HistoricoClinico>

@{
    ViewData["Title"] = "Histórico clínico";
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fa-solid fa-notes-medical"></i> Histórico clínico</h1>
        <p class="page-subtitle">Registros de procedimentos e acompanhamentos</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Novo registro
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon"><i class="fa-solid fa-notes-medical"></i></div>
        <p>Nenhum registro no histórico clínico.</p>
        <a asp-action="Create" class="btn btn-primary">Criar o primeiro</a>
    </div>
}
else
{
    <div class="table-card">
        <table class="table">
            <thead>
                <tr>
                    <th>Pet</th>
                    <th>Tipo</th>
                    <th>Descrição</th>
                    <th>Data</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@(item.Pet?.Nome ?? "—")</strong></td>
                        <td><span class="badge badge-tipo">@item.Tipo</span></td>
                        <td>@(item.Descricao ?? "—")</td>
                        <td>@item.Data.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
