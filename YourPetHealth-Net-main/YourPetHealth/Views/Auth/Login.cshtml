@{
    ViewData["Title"] = "Entrar";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-wrap">
    <div class="form-shell" style="width:100%">
        <div class="form-card-header">
            <h1>Entrar</h1>
            <p>Acompanhe a saúde dos seus pets</p>
        </div>

        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success mb-3">@TempData["Sucesso"]</div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger mb-3" data-testid="login-errors"></div>
        }

        <div class="form-panel">
            <form asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="email">E-mail</label>
                    <input id="email" name="email" type="email" required autofocus placeholder="seu@email.com" autocomplete="username" />
                </div>
                <div class="form-group">
                    <label for="senha">Senha</label>
                    <input id="senha" name="senha" type="password" required placeholder="••••••••" autocomplete="current-password" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-right-to-bracket"></i> Entrar
                    </button>
                </div>
            </form>
        </div>

        <p class="text-center mt-4 text-muted">
            Ainda não tem conta? <a asp-controller="Auth" asp-action="Register">Criar uma conta</a>
        </p>
    </div>
</div>
