@model YourPetHealth.Models.Consulta

@{
    ViewData["Title"] = "Editar consulta";
}

<div class="crumb">
    <a asp-action="Index">Consultas</a>
    <span class="sep">/</span>
    <span>Editar</span>
</div>

<div class="form-shell">
    <div class="form-card-header">
        <h1><i class="fa-solid fa-pen"></i> Editar consulta</h1>
        <p>Atualize os dados do atendimento</p>
    </div>

    <div class="form-panel">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="PetId">Pet</label>
                <select asp-for="PetId" asp-items="ViewBag.PetId" class="form-select"></select>
                <span asp-validation-for="PetId" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="VeterinarioId">Veterinário</label>
                <select asp-for="VeterinarioId" asp-items="ViewBag.VeterinarioId" class="form-select"></select>
                <span asp-validation-for="VeterinarioId" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Tipo">Tipo</label>
                <select asp-for="Tipo" class="form-select">
                    <option value="ROTINA">ROTINA</option>
                    <option value="VACINACAO">VACINACAO</option>
                    <option value="EMERGENCIA">EMERGENCIA</option>
                    <option value="RETORNO">RETORNO</option>
                    <option value="EXAME">EXAME</option>
                </select>
                <span asp-validation-for="Tipo" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Data">Data e hora</label>
                <input asp-for="Data" type="datetime-local" class="form-control" />
                <span asp-validation-for="Data" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descricao">Motivo</label>
                <textarea asp-for="Descricao" rows="2" class="form-control"></textarea>
                <span asp-validation-for="Descricao" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Observacoes">Observações</label>
                <textarea asp-for="Observacoes" rows="2" class="form-control"></textarea>
                <span asp-validation-for="Observacoes" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status">Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="AGENDADA">AGENDADA</option>
                    <option value="REALIZADA">REALIZADA</option>
                    <option value="CANCELADA">CANCELADA</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Salvar alterações
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
